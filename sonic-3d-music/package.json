{
  "name": "sonic-3d-music",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma web musical 3D: analizador de enlaces de YouTube, reproductor y convertidor de audio con FFmpeg (WebAssembly).",
  "scripts": {
    "preparar-ffmpeg": "node scripts/copiar-ffmpeg.mjs",
    "postinstall": "node scripts/copiar-ffmpeg.mjs",
    "dev": "next dev",
    "build": "node scripts/copiar-ffmpeg.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

# ---- Servidor (nunca se envían al navegador) ----------------------------------------------
# Clave de YouTube Data API v3 (Google Cloud Console > APIs y servicios > Credenciales).
# Restringe la clave a la API "YouTube Data API v3". Sin clave, el analizador usa el endpoint
# oficial oEmbed de YouTube (título, canal y miniatura; sin duración ni descripción ni listas).
YOUTUBE_API_KEY=

# Límite de consultas al analizador por IP y minuto (protección básica; en serverless es por instancia).
RATE_LIMIT_POR_MINUTO=30

# Hosts (coma) desde los que el servidor puede traer archivos de audio para convertirlos, solo
# https y solo cuando su descarga esté expresamente permitida (p. ej. tu propio CDN).
# Vacío = función desactivada. Ejemplo: ALLOWED_AUDIO_HOSTS=cdn.mi-dominio.com,archivos.ejemplo.org
ALLOWED_AUDIO_HOSTS=
# Tamaño máximo (MB) de un archivo traído por el servidor.
AUDIO_PROXY_MAX_MB=50

# ---- Cliente (públicas, se incrustan en el frontend) ----------------------------------------
# Límites del convertidor en el navegador.
NEXT_PUBLIC_MAX_FILE_MB=300
NEXT_PUBLIC_MAX_DURATION_MIN=180
# Ruta base del núcleo FFmpeg (por defecto se sirve desde /ffmpeg en el mismo origen).
NEXT_PUBLIC_FFMPEG_BASE_URL=/ffmpeg

# ---- Docker -------------------------------------------------------------------------------
# NEXT_OUTPUT=standalone
